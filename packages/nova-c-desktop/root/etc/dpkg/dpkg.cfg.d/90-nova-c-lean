# Nova-C OS keeps the system lean: files nobody reads on a laptop are not unpacked when a package is installed
# or upgraded (this is what keeps the image and the installed system a few hundred MB smaller).
#
#   * documentation and man pages (no man-db or help viewer is installed; copyright files stay)
#   * translations for languages outside the list below
#   * Plasma's stock wallpapers (Nova-C ships its own)
#
# Need another language? Delete this file, then:  sudo apt install --reinstall <package>   (or: sudo apt update
# && sudo apt full-upgrade after removing it, which restores the translations of every package that changes).

path-exclude=/usr/share/doc/*
path-include=/usr/share/doc/*/copyright
path-exclude=/usr/share/man/*
path-exclude=/usr/share/info/*
path-exclude=/usr/share/lintian/*
path-exclude=/usr/share/bug/*
path-exclude=/usr/share/gtk-doc/*
path-exclude=/usr/share/help/*

path-exclude=/usr/share/wallpapers/*
path-include=/usr/share/wallpapers/NovaC*/*

# translations kept: English, Arabic, Persian, Kurdish, Turkish, French, German, Spanish, Portuguese, Italian,
# Russian, Ukrainian, Polish, Dutch, Czech, Indonesian, Hindi, Vietnamese, Chinese, Japanese, Korean, Greek, Hebrew
