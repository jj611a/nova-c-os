#!/bin/sh
set -e

undivert() {   # undivert FILE TARGET
	dpkg-divert --package nova-c-desktop --remove --rename --divert "$2" "$1" >/dev/null
}

if [ "$1" = remove ] || [ "$1" = abort-install ] || [ "$1" = disappear ]; then
	undivert /usr/lib/os-release /usr/lib/os-release.debian
	undivert /etc/xdg/autostart/org.kde.discover.notifier.desktop /usr/share/nova-c/disabled-autostart/org.kde.discover.notifier.desktop
	rmdir /usr/share/nova-c/disabled-autostart /usr/share/nova-c 2>/dev/null || true
	systemctl --global unmask plasma-kaccess.service plasma-xembedsniproxy.service plasma-gmenudbusmenuproxy.service >/dev/null 2>&1 || true
	rm -f /usr/share/color-schemes/NovaC.colors
	systemctl --global unmask drkonqi-coredump-launcher.socket >/dev/null 2>&1 || true
	# back to Plymouth's default theme (ours is gone)
	if command -v plymouth-set-default-theme >/dev/null; then
		plymouth-set-default-theme --reset || true
		command -v update-initramfs >/dev/null && update-initramfs -u || true
	fi
fi
exit 0
