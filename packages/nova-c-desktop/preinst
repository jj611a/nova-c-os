#!/bin/sh
# Divert (move aside) files that other packages own and Nova-C replaces or switches off.
set -e

divert() {   # divert FILE TARGET
	dpkg-divert --package nova-c-desktop --add --rename --divert "$2" "$1" >/dev/null
}

A=/etc/xdg/autostart
OFF=/usr/share/nova-c/disabled-autostart

if [ "$1" = install ] || [ "$1" = upgrade ]; then
	# our os-release replaces base-files' copy (base-files upgrades keep updating the .debian one)
	divert /usr/lib/os-release /usr/lib/os-release.debian

	# 0.1.x moved four autostart files aside next to themselves (*.desktop.nova-c-disabled). systemd's autostart
	# generator still found and started them (the Discover notifier ran at ~135 MB). Undo that...
	for f in org.kde.discover.notifier kaccess xembedsniproxy gmenudbusmenuproxy; do
		dpkg-divert --package nova-c-desktop --remove --rename --divert "$A/$f.desktop.nova-c-disabled" "$A/$f.desktop" >/dev/null 2>&1 || true
	done
	# ...and put the one that is an autostart file out of the autostart directory altogether: Discover's tray update
	# notifier (updates install automatically instead). The other three are systemd user services in Plasma 6;
	# they are masked in postinst.
	mkdir -p "$OFF"
	divert "$A/org.kde.discover.notifier.desktop" "$OFF/org.kde.discover.notifier.desktop"
fi
exit 0
