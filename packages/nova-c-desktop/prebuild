#!/bin/bash
# Called by scripts/build-packages.sh with the package staging dir: render the wallpapers, the launcher icon, the
# boot/login splash artwork and the GRUB menu picture from assets/logo.png and the branding/*.svg.in templates
# (needs rsvg-convert).
set -euo pipefail
STAGE=$1; SRC=$2

# bash builtins only: the base64 logo (~140 KB) is over the 128 KB single-argument limit for sed/awk
LOGO_B64="$(base64 -w0 "$SRC/assets/logo.png")"
render() {   # render TEMPLATE WIDTH HEIGHT OUT [TOKEN=VALUE ...]
	local t; t="$(< "$SRC/branding/$1")"
	local out=$4 w=$2 h=$3; shift 4
	t="${t//@LOGO_B64@/$LOGO_B64}"
	local kv; for kv in "$@"; do t="${t//@${kv%%=*}@/${kv#*=}}"; done
	printf '%s\n' "$t" > "$STAGE.svg"
	mkdir -p "$(dirname "$out")"
	rsvg-convert -w "$w" -h "$h" "$STAGE.svg" -o "$out"
	rm -f "$STAGE.svg"
}

# desktop wallpapers (the first, NovaC, is the default and also the login screen's background)
W="$STAGE/usr/share/wallpapers"
variant() {   # variant DIR NAME BG0 BG1 BG2 GLOW_A GLOW_B HUE SAT
	render wallpaper.svg.in 1920 1080 "$W/$1/contents/images/1920x1080.png" \
		BG0="$3" BG1="$4" BG2="$5" GLOW_A="$6" GLOW_B="$7" HUE="$8" SAT="$9"
	cat > "$W/$1/metadata.json" <<EOF
{
    "KPlugin": {
        "Authors": [{ "Name": "Nova-C OS" }],
        "Id": "$1",
        "License": "CC-BY-SA-4.0",
        "Name": "$2"
    }
}
EOF
}
variant NovaC         "Nova-C"          '#050a12' '#091523' '#0c2233' '#1a8fa8' '#17406b' 0   1
variant NovaCAurora   "Nova-C Aurora"   '#070713' '#0d1230' '#1a1445' '#3b6fe0' '#7a2fa8' 55  1
variant NovaCGraphite "Nova-C Graphite" '#0a0c10' '#12161c' '#1b2028' '#5a7080' '#2a3340' 0   0.12

# artwork wallpapers: the photos from branding/wallpapers, copied as they are
photo() {   # photo DIR NAME FILE WIDTHxHEIGHT   (Plasma picks wallpaper files by their WxH name)
	mkdir -p "$W/$1/contents/images"
	cp "$SRC/branding/wallpapers/$3" "$W/$1/contents/images/$4.jpg"
	cat > "$W/$1/metadata.json" <<EOF2
{
    "KPlugin": {
        "Authors": [{ "Name": "Nova-C OS" }],
        "Id": "$1",
        "License": "see branding/wallpapers",
        "Name": "$2"
    }
}
EOF2
}
photo NovaCCircuit       "Nova-C Circuit"       circuit.jpg 1376x768
photo NovaCCrimsonTemple "Nova-C Crimson Temple" crimson-temple.jpg 1376x768
photo NovaCInk           "Nova-C Ink"           ink-mountain.jpg 1376x768
photo NovaCNebula        "Nova-C Nebula"        nebula-city.jpg 1376x768
photo NovaCRoninMoon     "Nova-C Ronin Moon"    ronin-moon.jpg 1595x736

# launcher/menu icon ("novac-logo")
render icon.svg.in 128 128 "$STAGE/usr/share/icons/hicolor/128x128/apps/novac-logo.png"
# login splash (Plasma) and boot splash (Plymouth) logo
render icon.svg.in 512 512 "$STAGE/usr/share/plasma/look-and-feel/org.novac.desktop/contents/splash/images/logo.png"
P="$STAGE/usr/share/plymouth/themes/novac"
render icon.svg.in 180 180 "$P/logo.png"
# soft cyan glow behind the logo (breathes while booting)
render plymouth-glow.svg.in 512 512 "$P/glow.png"
# boot splash progress bar: dim track and cyan fill (Plymouth scripts can only draw images)
bar() {   # bar COLOR OUT
	printf '<svg xmlns="http://www.w3.org/2000/svg" width="260" height="4"><rect width="260" height="4" rx="2" fill="%s"/></svg>' "$1" > "$STAGE.bar.svg"
	rsvg-convert "$STAGE.bar.svg" -o "$2"; rm -f "$STAGE.bar.svg"
}
bar '#1b2f3f' "$P/bar-track.png"
bar '#4ce1f0' "$P/bar-fill.png"

# boot menu picture of the installed system (the live ISO's is rendered by scripts/build.sh from the same template)
render grub-bg.svg.in 1920 1080 "$STAGE/usr/share/grub/themes/novac/background.png"
