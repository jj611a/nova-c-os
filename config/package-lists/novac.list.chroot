# ---- KDE Plasma 6 desktop (lean: recommends are off, so runtime pieces are listed explicitly) ----
plasma-desktop
plasma-workspace
kwin-wayland
kwin-x11
sddm
sddm-theme-breeze
kde-config-sddm
plasma-nm
plasma-pa
powerdevil
kscreen
bluedevil
kinfocenter
plasma-systemmonitor
plasma-integration
plasma-discover
xdg-desktop-portal-kde
xdg-desktop-portal-gtk
polkit-kde-agent-1
kde-cli-tools
qt6-wayland
systemsettings
udisks2
xwayland
# X11 fallback session (hardware/VMs where Wayland+EGL does not come up)
xserver-xorg-core
xserver-xorg-input-libinput

# ---- look: Breeze dark + Papirus icons + fonts ----
breeze
breeze-gtk-theme
kde-config-gtk-style
papirus-icon-theme
fonts-noto-core
fonts-noto-color-emoji
fonts-inter
fonts-firacode

# ---- apps ----
konsole
dolphin
kate
firefox-esr
fastfetch

# ---- laptop hardware ----
# fingerprint readers (enabled for login, lock screen and sudo by nova-c-desktop once a finger is enrolled)
fprintd
libpam-fprintd
# (the on-screen keyboard is not in the default image: it pulled in about 200 MB of Qt 5 and input-method data
# that a laptop with a real keyboard never uses. Touchscreen machines: sudo apt install nova-c-touch)
iio-sensor-proxy
thermald
pciutils
mokutil

# ---- Wi-Fi (network-manager only Recommends these; without wpasupplicant WPA/WPA2 Wi-Fi cannot connect) ----
wpasupplicant
wireless-regdb
iw
dnsmasq-base

# ---- sound: UCM profiles are required by SOF/modern Intel+AMD laptop audio; Bluetooth headsets ----
alsa-ucm-conf
alsa-topology-conf
alsa-utils
libspa-0.2-bluetooth

# ---- graphics: Vulkan (Intel/AMD/software) and hardware video decoding (Intel old+new, AMD, NVIDIA nouveau) ----
mesa-vulkan-drivers
mesa-va-drivers
intel-media-va-driver
i965-va-driver

# ---- live system (live-config only creates the live user if user-setup is installed) ----
user-setup

# ---- installer: Calamares copies the live system to disk; UEFI boot (laptops), Secure Boot via shim ----
calamares
calamares-settings-debian
grub-efi-amd64
grub-efi-amd64-signed
shim-signed
efibootmgr
os-prober
# tools the installer runs (Recommends of calamares/kpmcore, dropped with recommends off):
# unsquashfs copies the system to disk; mkfs.vfat formats the EFI partition; the rest let the
# partition page create/resize btrfs, xfs, NTFS (dual boot with Windows), GPT and LVM
squashfs-tools
dosfstools
mtools
btrfs-progs
xfsprogs
ntfs-3g
gdisk
lvm2
# password dictionary for the installer's password check (a dropped Recommends of libcrack2: without it every
# password fails with "error loading dictionary")
cracklib-runtime

# ---- updates: Nova-C packages + Debian security fixes install automatically (see nova-c-desktop) ----
unattended-upgrades
# HTTPS trust store for apt (the update repository is https; Firefox has its own, apt does not)
ca-certificates

# ---- things the desktop needs at runtime that are only "Recommends" ----
kbd
dbus-user-session
rtkit
upower
bluez
libgl1-mesa-dri
libegl-mesa0
libgles2
libgbm1

# ---- base system ----
systemd-sysv
# keeps the clock right (Recommends of systemd, dropped with recommends off): with a wrong clock apt rejects every signature as
# "not live yet", Debian's included
systemd-timesyncd
zstd
network-manager
pipewire
pipewire-pulse
wireplumber
flatpak
zram-tools
earlyoom
power-profiles-daemon
sudo
locales

# ---- firmware for broad laptop hardware support (non-free-firmware) ----
# Explicit list instead of the firmware-linux metapackage: that one pulls in firmware-b43-installer,
# which downloads proprietary firmware from GitHub during the image build (fragile, fails offline).
# Drivers that cannot ship in the image (NVIDIA's own driver, Broadcom wl, b43 firmware, old Intel ipw2x00)
# are offered after first boot by Hardware Drivers (packages/nova-c-driver-manager).
firmware-linux-free
firmware-amd-graphics
firmware-intel-graphics
firmware-intel-misc
firmware-intel-sound
firmware-nvidia-graphics
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-mediatek
firmware-brcm80211
firmware-libertas
firmware-ti-connectivity
firmware-ath9k-htc
firmware-sof-signed
firmware-cirrus
bluez-firmware
intel-microcode
amd64-microcode
