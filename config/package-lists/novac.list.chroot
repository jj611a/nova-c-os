firmware-amd-graphics
firmware-intel-graphics
firmware-intel-misc
firmware-intel-sound
firmware-nvidia-graphics
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-mediatek
firmware-brcm80211
firmware-libertas
