#!/bin/sh
# Calamares (Debian settings) with Nova-C names: installer window, GRUB/EFI entry and the menu launcher.
set -e
. /usr/lib/os-release   # from nova-c-desktop: NAME, VERSION_ID

B=/etc/calamares/branding/debian/branding.desc
if [ -f "$B" ]; then
	sed -i -E \
		-e "s/^( *productName: *).*/\1\"$NAME\"/" \
		-e 's/^( *shortProductName: *).*/\1"Nova-C"/' \
		-e "s/^( *version: *).*/\1\"$VERSION_ID\"/" \
		-e "s/^( *shortVersion: *).*/\1\"$VERSION_ID\"/" \
		-e "s/^( *versionedName: *).*/\1\"$NAME $VERSION_ID\"/" \
		-e "s/^( *shortVersionedName: *).*/\1\"Nova-C $VERSION_ID\"/" \
		-e 's/^( *bootloaderEntryName: *).*/\1"Nova-C"/' \
		-e 's#^( *productUrl: *).*#\1"https://github.com/jj611a/nova-c-os"#' \
		-e 's#^( *supportUrl: *).*#\1"https://github.com/jj611a/nova-c-os/issues"#' \
		-e 's#^( *knownIssuesUrl: *).*#\1"https://github.com/jj611a/nova-c-os/blob/main/docs/REPORT.md"#' \
		-e 's#^( *releaseNotesUrl: *).*#\1"https://github.com/jj611a/nova-c-os"#' \
		-e 's#^( *productLogo: *).*#\1"/usr/share/icons/hicolor/128x128/apps/novac-logo.png"#' \
		-e 's#^( *productIcon: *).*#\1"/usr/share/icons/hicolor/128x128/apps/novac-logo.png"#' \
		"$B"
	# welcome picture and install slideshow: the Nova-C wallpaper instead of Debian's artwork
	# (both are scaled to fit by Calamares; the wallpaper comes from nova-c-desktop)
	D=$(dirname "$B")
	W=/usr/share/wallpapers/NovaC/contents/images/1920x1080.png
	if [ -f "$W" ]; then
		cp "$W" "$D/welcome.png"
		cp "$W" "$D/slide1.png"
	fi
	sed -i "s#Welcome to Debian GNU/Linux.#Welcome to $NAME $VERSION_ID.#" "$D/show.qml"
fi

# Users page: show a "Require strong passwords" checkbox (on by default) so a simple password only warns
U=/etc/calamares/modules/users.conf
if [ -f "$U" ] && ! grep -q '^allowWeakPasswords:' "$U"; then
	printf '\nallowWeakPasswords: true\nallowWeakPasswordsDefault: false\n' >> "$U"
fi

# menu/desktop launcher: "Install Debian" -> "Install Nova-C OS"
for f in /usr/share/applications/*calamares*.desktop; do
	[ -f "$f" ] || continue
	sed -i -E -e 's/^Name(\[[^]]*\])?=.*/Name\1=Install Nova-C OS/' -e 's/^Icon=.*/Icon=novac-logo/' "$f"
done

# Debian's installer writes a fresh sources.list with only "main non-free-firmware". Nova-C also needs
# contrib + non-free on installed systems: NVIDIA and Broadcom Wi-Fi drivers, b43 firmware downloader
# (offered by Hardware Drivers). Our own update source (sources.list.d/nova-c.sources) is kept as is.
S=/usr/share/calamares/helpers/calamares-sources-final
[ -f "$S" ] && sed -i 's/ main non-free-firmware$/ main contrib non-free non-free-firmware/' "$S"

# The installed system does not need the installer: remove it from the target too (Debian's settings already remove
# live-boot, live-config and calamares-settings-debian). Otherwise "Install Nova-C OS" stays in the menu of a
# machine that is already installed.
P=/etc/calamares/modules/packages.conf
if [ -f "$P" ] && ! grep -q "^ *- 'calamares'$" "$P"; then
	sed -i "s/^\( *\)- 'calamares-settings-debian'/&\n\1- 'calamares'/" "$P"
fi
