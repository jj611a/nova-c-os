#!/bin/sh
# Nova-C OS identity in the image. os-release itself comes from the nova-c-desktop package (so updates can
# change it); here we only make /etc/os-release the usual symlink and set the console banners.
set -e

# /etc/os-release is a plain file in this image: make it the usual symlink so there is one source of truth
rm -f /etc/os-release
ln -s ../usr/lib/os-release /etc/os-release

# agetty expands \n (hostname) and \l (tty) itself, so keep them literal
cat > /etc/issue <<'EOT'
Nova-C OS \n \l

EOT
printf 'Nova-C OS\n' > /etc/issue.net
