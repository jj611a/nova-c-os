{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/etc/xdg/fastfetch/novac-logo.txt",
        "color": { "1": "cyan" },
        "padding": { "right": 3 }
    },
    "display": { "separator": "  " },
    "modules": [
        "title", "separator", "os", "host", "kernel", "uptime", "packages", "shell",
        "display", "de", "wm", "theme", "icons", "terminal", "cpu", "gpu", "memory", "disk", "break", "colors"
    ]
}
