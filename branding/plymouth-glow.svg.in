<?xml version="1.0" encoding="UTF-8"?>
<!-- Soft cyan halo behind the boot-splash logo (512x512, transparent edges). -->
<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
  <defs>
    <radialGradient id="g" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#4ce1f0" stop-opacity="0.38"/>
      <stop offset="0.45" stop-color="#2aa8c0" stop-opacity="0.14"/>
      <stop offset="1" stop-color="#2aa8c0" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="512" height="512" fill="url(#g)"/>
</svg>
